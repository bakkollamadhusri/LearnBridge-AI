# ====================================================================
# LearnBridge AI — Environment Configuration Template
# Tagline: Learn Anything. Connect with Everyone. Grow Together.
# ====================================================================

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
AI_PROVIDER=gemini # Options: "gemini", "openai", "builtin"

# AI Model Configuration (Optional: built-in pedagogical engine runs without keys)
# To use Google Gemini API:
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# To use OpenAI API:
OPENAI_API_KEY=your_openai_api_key_here

# Embedding Model Configuration
EMBEDDING_PROVIDER=local # Options: "local", "gemini", "openai"
EMBEDDING_MODEL=text-embedding-004

# Supabase Configuration (Optional cloud database & auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Frontend Configuration
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Media & Voice Services
ENABLE_TEXT_TO_SPEECH=true # Supports Web Speech API and backend TTS
DEFAULT_LANGUAGE=Telugu # Default UI & explanation preference
